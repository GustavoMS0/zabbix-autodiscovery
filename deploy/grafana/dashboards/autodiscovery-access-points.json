          },
          "functions": [
            {
              "def": {
                "name": "setAlias",
                "category": "Alias",
                "params": [
                  {
                    "name": "alias",
                    "type": "string"
                  }
                ],
                "defaultParams": []
              },
              "params": [
                "$__zbx_host_name"
              ],
              "text": "setAlias($__zbx_host_name)"
