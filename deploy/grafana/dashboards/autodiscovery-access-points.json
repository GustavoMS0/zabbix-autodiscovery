{
  "uid": "autodiscovery-access-points",
  "title": "AutoDiscovery - Access points",
  "tags": [
    "autodiscovery",
    "zabbix"
  ],
  "timezone": "browser",
  "refresh": "5m",
  "schemaVersion": 39,
  "editable": true,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [
    {
      "title": "AutoDiscovery dashboards",
      "type": "dashboards",
      "tags": [
        "autodiscovery"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Zabbix",
        "type": "datasource",
        "query": "alexanderzobnin-zabbix-datasource",
        "current": {
          "text": "zabbix",
          "value": "zabbix"
        },
        "hide": 0
      },
      {
        "name": "group",
        "label": "Group",
        "type": "query",
        "datasource": {
          "type": "alexanderzobnin-zabbix-datasource",
          "uid": "${datasource}"
        },
        "query": {
          "queryType": "group",
          "group": "/^(Rede\\/Access\\ Points)$/",
          "host": "",
          "application": "",
          "itemTag": "",
          "item": ""
        },
        "multi": true,
        "includeAll": true,
        "allValue": "/^(Rede\\/Access\\ Points)$/",
        "refresh": 1,
        "sort": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "alexanderzobnin-zabbix-datasource",
          "uid": "${datasource}"
        },
        "query": {
          "queryType": "host",
          "group": "$group",
          "host": "/.*/",
          "application": "",
          "itemTag": "",
          "item": ""
        },
        "multi": true,
        "includeAll": true,
        "allValue": "/.*/",
        "refresh": 1,
        "sort": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "timepicker": {
    "quick_ranges": [
      {
        "from": "now-5m",
        "to": "now",
        "display": "Last 5 minutes"
      },
      {
        "from": "now-15m",
        "to": "now",
        "display": "Last 15 minutes"
      },
      {
        "from": "now-30m",
        "to": "now",
        "display": "Last 30 minutes"
      },
      {
