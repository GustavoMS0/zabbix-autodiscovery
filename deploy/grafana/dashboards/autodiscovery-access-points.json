      "type": "alexanderzobnin-zabbix-triggers-panel",
      "title": "Problems - Access points",
      "datasource": {
        "type": "alexanderzobnin-zabbix-datasource",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "5",
          "datasource": {
            "type": "alexanderzobnin-zabbix-datasource",
            "uid": "${datasource}"
          },
          "group": {
            "filter": "$group"
          },
          "host": {
            "filter": "$host"
          },
          "application": {
            "filter": ""
          },
          "proxy": {
            "filter": ""
          },
          "trigger": {
            "filter": ""
          },
          "tags": {
            "filter": ""
          },
          "showProblems": "problems",
          "options": {
            "minSeverity": 1,
            "acknowledged": 2,
            "sortProblems": "priority",
            "hostsInMaintenance": false,
            "limit": 500
          }
        }
      ],
      "options": {
        "hostField": true,
        "hostGroups": true,
        "severityField": true,
        "ageField": true,
        "showTags": true,
        "pageSize": 10
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      }
