{
  "uid": "autodiscovery-firewalls",
  "title": "AutoDiscovery - Firewalls",
  "tags": [
    "autodiscovery",
    "zabbix"
  ],
  "timezone": "browser",
  "refresh": "1m",
  "schemaVersion": 39,
  "editable": true,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [
    {
      "title": "AutoDiscovery dashboards",
      "type": "dashboards",
      "tags": [
        "autodiscovery"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Zabbix",
        "type": "datasource",
        "query": "alexanderzobnin-zabbix-datasource",
        "current": {
          "text": "zabbix",
          "value": "zabbix"
        },
        "hide": 0
      },
      {
        "name": "group",
        "label": "Group",
        "type": "query",
        "datasource": {
          "type": "alexanderzobnin-zabbix-datasource",
          "uid": "${datasource}"
        },
        "query": {
          "queryType": "group",
          "group": "/^(Rede\\/Firewalls)$/",
          "host": "",
          "application": "",
          "itemTag": "",
          "item": ""
        },
        "multi": true,
        "includeAll": true,
        "allValue": "/^(Rede\\/Firewalls)$/",
        "refresh": 1,
        "sort": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "alexanderzobnin-zabbix-datasource",
          "uid": "${datasource}"
        },
        "query": {
          "queryType": "host",
          "group": "$group",
          "host": "/.*/",
          "application": "",
          "itemTag": "",
          "item": ""
        },
        "multi": true,
        "includeAll": true,
        "allValue": "/.*/",
        "refresh": 2,
        "sort": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "alexanderzobnin-zabbix-triggers-panel",
      "title": "Problems - Firewalls",
      "datasource": {
        "type": "alexanderzobnin-zabbix-datasource",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "5",
          "datasource": {
            "type": "alexanderzobnin-zabbix-datasource",
            "uid": "${datasource}"
          },
          "group": {
            "filter": "$group"
          },
          "host": {
            "filter": "$host"
          },
          "application": {
            "filter": ""
          },
          "proxy": {
            "filter": ""
          },
          "trigger": {
            "filter": ""
          },
          "tags": {
            "filter": ""
          },
          "showProblems": "problems",
          "options": {
            "minSeverity": 1,
            "acknowledged": 2,
            "sortProblems": "priority",
            "hostsInMaintenance": false,
            "limit": 500
          }
        }
      ],
      "options": {
        "hostField": true,
        "hostGroups": true,
        "severityField": true,
        "ageField": true,
        "showTags": true,
        "pageSize": 10
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      }
    },
    {
      "type": "stat",
      "title": "Availability (ICMP)",
      "datasource": {
        "type": "alexanderzobnin-zabbix-datasource",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "0",
          "datasource": {
            "type": "alexanderzobnin-zabbix-datasource",
            "uid": "${datasource}"
          },
          "group": {
            "filter": "$group"
          },
          "host": {
            "filter": "$host"
          },
          "application": {
            "filter": ""
          },
          "itemTag": {
            "filter": ""
          },
          "item": {
            "filter": "ICMP ping"
          },
          "functions": [
            {
              "def": {
                "name": "setAlias",
                "category": "Alias",
                "params": [
                  {
                    "name": "alias",
                    "type": "string"
                  }
                ],
                "defaultParams": []
              },
              "params": [
                "$__zbx_host_name"
              ],
              "text": "setAlias($__zbx_host_name)"
            }
          ],
          "options": {
            "showDisabledItems": false,
            "skipEmptyValues": true
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false,
          "fields": ""
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "auto",
        "wideLayout": true
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 6
      }
    },
    {
      "type": "stat",
      "title": "WAN Links Operational Status",
      "datasource": {
        "type": "alexanderzobnin-zabbix-datasource",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "0",
          "datasource": {
            "type": "alexanderzobnin-zabbix-datasource",
            "uid": "${datasource}"
          },
          "group": {
            "filter": "$group"
          },
          "host": {
            "filter": "$host"
          },
          "application": {
            "filter": ""
          },
          "itemTag": {
            "filter": ""
          },
          "item": {
            "filter": "/interface\\s+(?!fortilink|loopback)(wan\\d*|uplink\\d*|internet\\d*|a\\([^)]*(wan|internet|net\\s*fiber|mbps|ligga|its|easy|america|mega)[^)]*\\)).*: operational status/i"
          },
          "functions": [
            {
              "def": {
                "name": "setAlias",
                "category": "Alias",
                "params": [
                  {
                    "name": "alias",
                    "type": "string"
                  }
                ],
                "defaultParams": []
              },
              "params": [
                "$__zbx_host_name: $__zbx_item"
              ],
              "text": "setAlias($__zbx_host_name: $__zbx_item)"
            },
            {
              "def": {
                "name": "replaceAlias",
                "category": "Alias",
                "params": [
                  {
                    "name": "regexp",
                    "type": "string"
                  },
                  {
                    "name": "newAlias",
                    "type": "string"
                  }
                ],
                "defaultParams": [
                  "/(.*)/",
                  "$1"
                ]
              },
              "params": [
                "/^(?:Interface\\s+)?([^:]+):\\s+Operational status$/i",
                "$__zbx_host_name - $1"
              ],
              "text": "replaceAlias(/^(?:Interface\\s+)?([^:]+):\\s+Operational status$/i, $__zbx_host_name - $1)"
            }
          ],
          "options": {
            "showDisabledItems": false,
            "skipEmptyValues": true
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false,
          "fields": ""
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "auto",
        "wideLayout": false
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 0
                },
                "2": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 1
                },
                "3": {
                  "text": "TESTING",
                  "color": "yellow",
                  "index": 2
                },
                "4": {
                  "text": "UNKNOWN",
                  "color": "orange",
                  "index": 3
                },
                "5": {
                  "text": "DORMANT",
                  "color": "blue",
                  "index": 4
                },
                "6": {
                  "text": "NOT PRESENT",
                  "color": "dark-grey",
                  "index": 5
                },
                "7": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 6
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 6
      }
    },
