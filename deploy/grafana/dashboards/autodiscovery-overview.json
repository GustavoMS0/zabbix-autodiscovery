{
  "uid": "autodiscovery-overview",
  "title": "AutoDiscovery - Network overview",
  "tags": [
    "autodiscovery",
    "zabbix"
  ],
  "timezone": "browser",
  "refresh": "5m",
  "schemaVersion": 39,
  "editable": true,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [
    {
      "title": "AutoDiscovery dashboards",
      "type": "dashboards",
      "tags": [
        "autodiscovery"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Zabbix",
        "type": "datasource",
        "query": "alexanderzobnin-zabbix-datasource",
        "current": {
          "text": "zabbix",
          "value": "zabbix"
        },
        "hide": 0
      },
      {
        "name": "group",
        "label": "Group",
        "type": "query",
        "datasource": {
          "type": "alexanderzobnin-zabbix-datasource",
          "uid": "${datasource}"
        },
        "query": {
          "queryType": "group",
          "group": "/^(Infra\\/Hardware\\ Servidores|Infra\\/Nobreaks|Infra\\/PDU|Infra\\/Storage|Rede\\/Access\\ Points|Rede\\/Firewalls|Rede\\/Impressoras|Rede\\/Outros|Rede\\/Roteadores|Rede\\/Switches|Seguranca\\/CFTV|Servidores\\/Hypervisors|Servidores\\/Linux|Servidores\\/Windows|Telefonia\\/VoIP)$/",
          "host": "",
          "application": "",
          "itemTag": "",
          "item": ""
        },
        "multi": true,
        "includeAll": true,
        "allValue": "/^(Infra\\/Hardware\\ Servidores|Infra\\/Nobreaks|Infra\\/PDU|Infra\\/Storage|Rede\\/Access\\ Points|Rede\\/Firewalls|Rede\\/Impressoras|Rede\\/Outros|Rede\\/Roteadores|Rede\\/Switches|Seguranca\\/CFTV|Servidores\\/Hypervisors|Servidores\\/Linux|Servidores\\/Windows|Telefonia\\/VoIP)$/",
        "refresh": 1,
        "sort": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "alexanderzobnin-zabbix-datasource",
          "uid": "${datasource}"
        },
        "query": {
          "queryType": "host",
          "group": "$group",
          "host": "/.*/",
          "application": "",
          "itemTag": "",
          "item": ""
        },
        "multi": true,
        "includeAll": true,
        "allValue": "/.*/",
        "refresh": 1,
        "sort": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "timepicker": {
    "quick_ranges": [
      {
        "from": "now-5m",
        "to": "now",
        "display": "Last 5 minutes"
      },
      {
        "from": "now-15m",
        "to": "now",
        "display": "Last 15 minutes"
      },
      {
        "from": "now-30m",
        "to": "now",
        "display": "Last 30 minutes"
      },
      {
        "from": "now-1h",
        "to": "now",
        "display": "Last 1 hour"
      },
      {
        "from": "now-3h",
        "to": "now",
        "display": "Last 3 hours"
      },
      {
        "from": "now-6h",
        "to": "now",
        "display": "Last 6 hours"
      },
      {
        "from": "now-12h",
        "to": "now",
        "display": "Last 12 hours"
      },
      {
        "from": "now-1d",
        "to": "now",
        "display": "Last 24 hours"
      },
      {
        "from": "now-2d",
        "to": "now",
        "display": "Last 2 days"
      }
    ]
  },
  "panels": [
    {
      "type": "alexanderzobnin-zabbix-triggers-panel",
      "title": "Problems - Network overview",
      "datasource": {
        "type": "alexanderzobnin-zabbix-datasource",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "5",
          "datasource": {
            "type": "alexanderzobnin-zabbix-datasource",
            "uid": "${datasource}"
          },
          "group": {
            "filter": "$group"
          },
          "host": {
            "filter": "$host"
          },
          "application": {
            "filter": ""
          },
          "proxy": {
            "filter": ""
          },
          "trigger": {
            "filter": ""
          },
          "tags": {
            "filter": ""
          },
          "showProblems": "problems",
          "options": {
            "minSeverity": 2,
            "acknowledged": 2,
            "sortProblems": "priority",
            "hostsInMaintenance": false,
            "limit": 500
          }
        }
      ],
      "options": {
        "hostField": true,
        "hostGroups": true,
        "severityField": true,
        "ageField": true,
        "showTags": true,
        "pageSize": 10
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      }
    },
    {
      "type": "stat",
