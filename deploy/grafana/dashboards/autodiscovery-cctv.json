{
  "uid": "autodiscovery-cctv",
  "title": "AutoDiscovery - CCTV & Cameras",
  "tags": [
    "autodiscovery",
    "zabbix"
  ],
  "timezone": "browser",
  "refresh": "1m",
  "schemaVersion": 39,
  "editable": true,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [
    {
      "title": "AutoDiscovery dashboards",
      "type": "dashboards",
      "tags": [
        "autodiscovery"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Zabbix",
        "type": "datasource",
        "query": "alexanderzobnin-zabbix-datasource",
        "current": {
          "text": "zabbix",
          "value": "zabbix"
        },
        "hide": 0
      },
      {
        "name": "group",
        "label": "Group",
        "type": "query",
        "datasource": {
          "type": "alexanderzobnin-zabbix-datasource",
          "uid": "${datasource}"
        },
        "query": {
          "queryType": "group",
          "group": "/^(Security\\/CCTV)$/",
          "host": "",
          "application": "",
          "itemTag": "",
          "item": ""
        },
        "multi": true,
        "includeAll": true,
        "allValue": "/^(Security\\/CCTV)$/",
        "refresh": 1,
        "sort": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "alexanderzobnin-zabbix-datasource",
          "uid": "${datasource}"
        },
        "query": {
          "queryType": "host",
          "group": "$group",
          "host": "/.*/",
          "application": "",
          "itemTag": "",
          "item": ""
        },
        "multi": true,
        "includeAll": true,
        "allValue": "/.*/",
        "refresh": 2,
        "sort": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "alexanderzobnin-zabbix-triggers-panel",
      "title": "Problems - CCTV & Cameras",
      "datasource": {
        "type": "alexanderzobnin-zabbix-datasource",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "5",
          "datasource": {
            "type": "alexanderzobnin-zabbix-datasource",
            "uid": "${datasource}"
          },
          "group": {
            "filter": "$group"
          },
          "host": {
            "filter": "$host"
          },
          "application": {
            "filter": ""
          },
          "proxy": {
            "filter": ""
          },
          "trigger": {
            "filter": ""
          },
          "tags": {
            "filter": ""
          },
          "showProblems": "problems",
          "options": {
            "minSeverity": 1,
            "acknowledged": 2,
            "sortProblems": "priority",
            "hostsInMaintenance": false,
            "limit": 500
          }
        }
      ],
      "options": {
        "hostField": true,
        "hostGroups": true,
        "severityField": true,
        "ageField": true,
        "showTags": true,
        "pageSize": 10
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      }
    },
    {
      "type": "stat",
      "title": "Availability (ICMP)",
      "datasource": {
        "type": "alexanderzobnin-zabbix-datasource",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "0",
          "datasource": {
            "type": "alexanderzobnin-zabbix-datasource",
            "uid": "${datasource}"
          },
          "group": {
            "filter": "$group"
          },
          "host": {
            "filter": "$host"
          },
          "application": {
            "filter": ""
          },
          "itemTag": {
            "filter": ""
          },
          "item": {
            "filter": "ICMP ping"
          },
          "functions": [
            {
              "def": {
                "name": "setAlias",
                "category": "Alias"
              },
              "params": [
                "$__zbx_host_name"
              ]
            }
          ],
          "options": {
            "showDisabledItems": false,
            "skipEmptyValues": true
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false,
          "fields": ""
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "auto",
        "wideLayout": true
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 6
      }
    },
    {
      "type": "timeseries",
      "title": "ICMP latency",
      "datasource": {
        "type": "alexanderzobnin-zabbix-datasource",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "0",
          "datasource": {
            "type": "alexanderzobnin-zabbix-datasource",
            "uid": "${datasource}"
          },
          "group": {
            "filter": "$group"
          },
          "host": {
            "filter": "$host"
          },
          "application": {
            "filter": ""
          },
          "itemTag": {
            "filter": ""
          },
          "item": {
            "filter": "ICMP response time"
          },
          "functions": [
            {
              "def": {
                "name": "setAlias",
                "category": "Alias"
              },
              "params": [
                "$__zbx_host_name"
              ]
            }
          ],
          "options": {
            "showDisabledItems": false,
            "skipEmptyValues": true
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Network traffic (top 10)",
      "datasource": {
        "type": "alexanderzobnin-zabbix-datasource",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "0",
          "datasource": {
            "type": "alexanderzobnin-zabbix-datasource",
            "uid": "${datasource}"
          },
          "group": {
            "filter": "$group"
          },
          "host": {
            "filter": "$host"
          },
          "application": {
            "filter": ""
          },
          "itemTag": {
            "filter": ""
          },
          "item": {
            "filter": "/Bits received/"
          },
          "functions": [
            {
              "def": {
                "name": "setAlias",
                "category": "Alias"
              },
              "params": [
                "$__zbx_host_name: $__zbx_item"
              ]
            },
            {
              "def": {
                "name": "top",
                "category": "Filter"
              },
              "params": [
                "10",
                "avg"
              ]
            }
          ],
          "options": {
            "showDisabledItems": false,
            "skipEmptyValues": true
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 4,
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "stat",
      "title": "Uptime",
      "datasource": {
        "type": "alexanderzobnin-zabbix-datasource",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "0",
          "datasource": {
            "type": "alexanderzobnin-zabbix-datasource",
            "uid": "${datasource}"
          },
          "group": {
            "filter": "$group"
          },
          "host": {
            "filter": "$host"
          },
          "application": {
            "filter": ""
          },
          "itemTag": {
            "filter": ""
          },
          "item": {
            "filter": "/uptime/i"
          },
          "functions": [
            {
              "def": {
                "name": "setAlias",
                "category": "Alias"
              },
              "params": [
                "$__zbx_host_name"
              ]
            }
          ],
          "options": {
            "showDisabledItems": false,
            "skipEmptyValues": true
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false,
          "fields": ""
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "auto",
        "wideLayout": true
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "unit": "s"
        },
        "overrides": []
      },
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 5
      }
    }
  ]
}