{
  "uid": "autodiscovery-server-hardware",
  "title": "AutoDiscovery - Server hardware (iDRAC/iLO)",
  "tags": [
    "autodiscovery",
    "zabbix"
  ],
  "timezone": "browser",
  "refresh": "5m",
  "schemaVersion": 39,
  "editable": true,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [
    {
      "title": "AutoDiscovery dashboards",
      "type": "dashboards",
      "tags": [
        "autodiscovery"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Zabbix",
        "type": "datasource",
        "query": "alexanderzobnin-zabbix-datasource",
        "current": {
          "text": "zabbix",
          "value": "zabbix"
        },
        "hide": 0
      },
      {
        "name": "group",
        "label": "Group",
        "type": "query",
        "datasource": {
          "type": "alexanderzobnin-zabbix-datasource",
          "uid": "${datasource}"
        },
        "query": {
          "queryType": "group",
          "group": "/^(Infrastructure\\/Server\\ Hardware)$/",
          "host": "",
          "application": "",
          "itemTag": "",
          "item": ""
        },
        "multi": true,
        "includeAll": true,
        "allValue": "/^(Infrastructure\\/Server\\ Hardware)$/",
        "refresh": 1,
        "sort": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "alexanderzobnin-zabbix-datasource",
          "uid": "${datasource}"
        },
        "query": {
          "queryType": "host",
          "group": "$group",
          "host": "/.*/",
          "application": "",
          "itemTag": "",
          "item": ""
        },
        "multi": true,
        "includeAll": true,
        "allValue": "/.*/",
        "refresh": 1,
        "sort": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "timepicker": {
    "quick_ranges": [
      {
        "from": "now-5m",
        "to": "now",
        "display": "Last 5 minutes"
      },
      {
        "from": "now-15m",
        "to": "now",
        "display": "Last 15 minutes"
      },
      {
        "from": "now-30m",
        "to": "now",
        "display": "Last 30 minutes"
      },
      {
        "from": "now-1h",
        "to": "now",
        "display": "Last 1 hour"
      },
      {
        "from": "now-3h",
        "to": "now",
        "display": "Last 3 hours"
      },
      {
        "from": "now-6h",
        "to": "now",
        "display": "Last 6 hours"
      },
      {
        "from": "now-12h",
        "to": "now",
        "display": "Last 12 hours"
      },
      {
        "from": "now-1d",
        "to": "now",
        "display": "Last 24 hours"
      },
      {
        "from": "now-2d",
        "to": "now",
        "display": "Last 2 days"
      }
    ]
  },
  "panels": [
    {
      "type": "alexanderzobnin-zabbix-triggers-panel",
      "title": "Problems - Server hardware (iDRAC/iLO)",
      "datasource": {
        "type": "alexanderzobnin-zabbix-datasource",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "5",
          "datasource": {
            "type": "alexanderzobnin-zabbix-datasource",
            "uid": "${datasource}"
          },
          "group": {
            "filter": "$group"
          },
          "host": {
            "filter": "$host"
          },
          "application": {
            "filter": ""
          },
          "proxy": {
            "filter": ""
          },
          "trigger": {
            "filter": ""
          },
          "tags": {
            "filter": ""
          },
          "showProblems": "problems",
          "options": {
            "minSeverity": 1,
            "acknowledged": 2,
            "sortProblems": "priority",
            "hostsInMaintenance": false,
            "limit": 500
          }
        }
      ],
      "options": {
        "hostField": true,
        "hostGroups": true,
        "severityField": true,
        "ageField": true,
        "showTags": true,
        "pageSize": 10
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      }
    },
    {
      "type": "stat",
      "title": "Availability",
      "datasource": {
        "type": "alexanderzobnin-zabbix-datasource",
        "uid": "${datasource}"
      },
      "maxDataPoints": 100,
      "targets": [
        {
          "refId": "A",
          "queryType": "0",
          "datasource": {
            "type": "alexanderzobnin-zabbix-datasource",
            "uid": "${datasource}"
          },
          "group": {
            "filter": "$group"
          },
          "host": {
            "filter": "$host"
          },
          "application": {
            "filter": ""
          },
          "itemTag": {
            "filter": ""
          },
          "item": {
            "filter": "/^SNMP agent availability$/"
          },
          "functions": [
            {
              "def": {
                "name": "setAlias",
                "category": "Alias",
                "params": [
                  {
                    "name": "alias",
                    "type": "string"
                  }
                ],
                "defaultParams": []
              },
              "params": [
                "$__zbx_host_name"
              ],
              "text": "setAlias($__zbx_host_name)"
            }
          ],
          "options": {
            "showDisabledItems": false,
            "skipEmptyValues": true,
            "disableDataAlignment": true,
            "useTrends": "false"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false,
          "fields": ""
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "auto",
        "wideLayout": true
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                },
                "2": {
                  "text": "UNKNOWN",
                  "color": "#8e8e8e"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              },
              {
                "color": "#8e8e8e",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      },
      "timeFrom": "24h",
      "hideTimeOverride": true,
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 6
      }
    },
    {
      "type": "timeseries",
      "title": "Temperatures",
      "datasource": {
        "type": "alexanderzobnin-zabbix-datasource",
        "uid": "${datasource}"
      },
      "maxDataPoints": 500,
      "targets": [
        {
          "refId": "A",
          "queryType": "0",
          "datasource": {
            "type": "alexanderzobnin-zabbix-datasource",
            "uid": "${datasource}"
          },
          "group": {
            "filter": "$group"
          },
          "host": {
            "filter": "$host"
          },
          "application": {
            "filter": ""
          },
          "itemTag": {
            "filter": ""
          },
          "item": {
            "filter": "/^Probe \\[.*Temp.*\\]: Value$/"
          },
          "functions": [
            {
              "def": {
                "name": "setAlias",
                "category": "Alias",
                "params": [
                  {
                    "name": "alias",
                    "type": "string"
                  }
                ],
                "defaultParams": []
              },
              "params": [
                "$__zbx_host_name: $__zbx_item"
              ],
              "text": "setAlias($__zbx_host_name: $__zbx_item)"
            }
          ],
          "options": {
            "showDisabledItems": false,
            "skipEmptyValues": true,
            "disableDataAlignment": true,
            "useTrends": "false"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Fans",
      "datasource": {
        "type": "alexanderzobnin-zabbix-datasource",
        "uid": "${datasource}"
      },
      "maxDataPoints": 200,
      "targets": [
        {
          "refId": "A",
          "queryType": "0",
          "datasource": {
            "type": "alexanderzobnin-zabbix-datasource",
            "uid": "${datasource}"
          },
          "group": {
            "filter": "$group"
          },
          "host": {
            "filter": "$host"
          },
          "application": {
            "filter": ""
