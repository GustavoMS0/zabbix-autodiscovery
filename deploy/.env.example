# Copy to .env and change every password
TZ=UTC

# Official Zabbix image tag (zabbix/zabbix-server-pgsql, zabbix-web-nginx-pgsql, zabbix-agent2)
ZABBIX_TAG=ubuntu-8.0-latest
GRAFANA_VERSION=12.2.0

POSTGRES_USER=zabbix
POSTGRES_PASSWORD=change-me

GRAFANA_ADMIN_PASSWORD=change-me

# Zabbix API used by Grafana. Keep the default for the bundled Zabbix,
# or point it to an existing one, e.g. https://zabbix.example.com/api_jsonrpc.php
ZABBIX_API_URL=http://zabbix-web:8080/api_jsonrpc.php

# Read-only Zabbix user for Grafana, created by "zabbix-autodiscovery setup" (grafana_user in config.yaml)
ZABBIX_GRAFANA_USER=grafana
ZABBIX_GRAFANA_PASSWORD=change-me
